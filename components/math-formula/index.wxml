<!-- WXML禁止同名模板递归；使用16层有界公式模板。公式树在测试中校验深度。 -->
<template name="math-node-0">
  <view wx:if="{{node.kind === 'row'}}" class="math-row"><block wx:for="{{node.children}}" wx:key="id"><template is="math-node-1" data="{{node:item}}" /></block></view>
  <view wx:elif="{{node.kind === 'fraction'}}" class="math-fraction"><view class="math-numerator"><template is="math-node-1" data="{{node:node.numerator}}" /></view><view class="math-denominator"><template is="math-node-1" data="{{node:node.denominator}}" /></view></view>
  <view wx:elif="{{node.kind === 'script'}}" class="math-script"><template is="math-node-1" data="{{node:node.base}}" /><view class="math-script-column"><view wx:if="{{node.upper}}" class="math-upper"><template is="math-node-1" data="{{node:node.upper}}" /></view><view wx:if="{{node.lower}}" class="math-lower"><template is="math-node-1" data="{{node:node.lower}}" /></view></view></view>
  <view wx:elif="{{node.kind === 'root'}}" class="math-row"><text class="math-root-symbol">√</text><view class="math-root-body"><template is="math-node-1" data="{{node:node.body}}" /></view></view>
  <scientific-text wx:else text-class="math-text" selectable value="{{node.value}}" />
</template>
