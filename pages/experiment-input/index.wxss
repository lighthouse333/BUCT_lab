@import "../spectral-analysis/index.wxss";

.record-guide { margin-bottom: 24rpx; padding: 20rpx 24rpx; background: #eaf1ff; border-radius: 16rpx; color: #204fa3; font-size: 25rpx; line-height: 1.7; }
.record-guide .hint { margin-bottom: 0; }
.date-field { width: calc(50% - 10rpx); font-size: 25rpx; }
.date-value { margin-top: 10rpx; min-height: 76rpx; display: flex; align-items: center; padding: 0 14rpx; background: #f4f7fb; border-radius: 8rpx; font-size: 25rpx; }
.placeholder { color: #8b96a7; }
.parameter-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.parameter-field { width: calc(50% - 10rpx); min-width: 0; font-size: 24rpx; line-height: 1.6; }
.parameter-field > text:first-child { display: block; min-height: 76rpx; }
.parameter-field input { background: #eef4ff; color: #204fa3; }
.table-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.table-heading .section-title { flex: 1; }
.table-badge { flex-shrink: 0; padding: 6rpx 14rpx; border-radius: 999rpx; background: #edf3ff; color: #204fa3; font-size: 22rpx; line-height: 1.5; }
.record-table { font-size: 24rpx; }
.record-cell, .row-index { flex-shrink: 0; box-sizing: border-box; border-right: 2rpx solid #64748b; border-bottom: 2rpx solid #64748b; }
.record-cell { width: 210rpx; min-height: 90rpx; }
.row-index { width: 90rpx; display: flex; align-items: center; justify-content: center; min-height: 90rpx; background: #f1f5f9; color: #64748b; }
.column-header { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 16rpx 10rpx; min-height: 112rpx; background: #f1f5f9; line-height: 1.5; text-align: center; }
.column-header .unit { color: #64748b; font-size: 21rpx; margin-top: 4rpx; }
.computed-header { background: #e8edf5; }
.editable-cell { background: #eef4ff; color: #204fa3; }
.record-cell input { width: 100%; height: 90rpx; padding: 0 10rpx; box-sizing: border-box; font-size: 25rpx; text-align: center; }
.computed-cell { background: #f4f6f9; color: #526176; }
.computed-value { display: flex; align-items: center; justify-content: center; min-height: 90rpx; padding: 10rpx; box-sizing: border-box; overflow-wrap: anywhere; text-align: center; }
.cell-error { display: block; color: #b42318; font-size: 21rpx; line-height: 1.6; padding: 4rpx 8rpx 10rpx; overflow-wrap: anywhere; }
.cell-invalid { box-shadow: inset 0 0 0 2rpx #d92d20; }
label input.invalid-input { border: 1rpx solid #d92d20; }
.full-label textarea { width: 100%; min-height: 128rpx; margin-top: 12rpx; padding: 18rpx; border-radius: 10rpx; background: #f4f7fb; box-sizing: border-box; font-size: 25rpx; line-height: 1.7; }
.validation-card { border-color: #f0b1aa; background: #fffafa; }
.export-card .clear-button { background: #f2f4f7; color: #526176; }
.status-text { display: block; margin-top: 18rpx; color: #204fa3; font-size: 24rpx; line-height: 1.7; }
